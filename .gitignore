.DS_Store
.env
.env.*
!.env.example

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log
*.mdmp

# Minecraft server runtime data
**/.console_history
**/cache/
**/crash-reports/
**/debug/
**/debug.txt
**/logs/
**/*.log
**/libraries/
**/versions/
**/world/
**/world_nether/
**/world_the_end/

# Bundled JDKs and binaries
**/jdk-*/
**/*.jar
**/*.jar111
**/plugins/*.zip
**/plugins.zip
**/*.7z

# Plugin runtime data
**/plugins/**/.libs/
**/plugins/**/.paper-remapped/
**/plugins/**/.archive-unpack/
**/plugins/**/PlayerData/
**/plugins/**/playerdata/
**/plugins/**/userdata/
**/plugins/**/usercache/
# player name cache at server root, regenerated on start (not the plugins/**/usercache/ dir above)
**/usercache.json
# server-written version record, regenerated on start
**/version_history.json
**/plugins/**/backup/
**/plugins/**/backups/
**/config/backup*/
**/plugins/**/lib/
**/plugins/**/libs/
**/plugins/**/ip-data/
**/plugins/**/database/
**/plugins/**/Save/
**/plugins/**/Saves/
**/plugins/**/data/
**/plugins/**/data/**
**/plugins/**/players/
**/plugins/**/players/**
**/plugins/**/cooldowns/
**/plugins/**/cooldowns/**
**/plugins/**/skins/
**/plugins/**/skins/**
**/plugins/**/lastupdate
**/plugins/**/qs.log
**/plugins/**/temp/
**/plugins/**/cache/
# EssentialsX item id data bundled with the plugin jar, regenerated on load
**/plugins/Essentials/items.json
# Plan auto-downloads the GeoIP database on first run
**/plugins/Plan/GeoLite2-Country.mmdb
**/*.tmp
**/*.db
**/*.mv.db
**/*.trace.db
**/*.bin
**/map-color-cache.dat
**/plugins/**/sessions/
**/plugins/**/schematics/
**/plugins/**/tmp/
**/plugins/**/tmp-client/

# Secrets and keys
**/*.secret
**/forwarding.secret
**/*.pem
**/*.playerskin
# BungeeGuard is decommissioned (migrated to Velocity modern forwarding); never track its config/token
**/BungeeGuard/
**/token.txt

# Unified launcher runtime
pids/
**/*.jar.disabled
