.DS_Store
.env
.env.*
!.env.example

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log
*.mdmp

# Minecraft server runtime data
**/.console_history
**/cache/
**/crash-reports/
**/debug/
**/debug.txt
**/logs/
**/*.log
**/libraries/
**/versions/
**/world/
**/world_nether/
**/world_the_end/

# Bundled JDKs and binaries
**/jdk-*/
**/*.jar
**/*.jar111
**/plugins/*.zip
**/plugins.zip
**/*.7z

# Plugin runtime data
**/plugins/**/.libs/
**/plugins/**/.paper-remapped/
**/plugins/**/.archive-unpack/
**/plugins/**/PlayerData/
**/plugins/**/playerdata/
**/plugins/**/userdata/
**/plugins/**/usercache/
# player name cache at server root, regenerated on start (not the plugins/**/usercache/ dir above)
**/usercache.json
# server-written version record, regenerated on start
**/version_history.json
**/plugins/**/backup/
**/plugins/**/backups/
**/config/backup*/
**/plugins/**/lib/
**/plugins/**/libs/
**/plugins/**/ip-data/
**/plugins/**/database/
**/plugins/**/Save/
**/plugins/**/Saves/
**/plugins/**/data/
**/plugins/**/data/**
**/plugins/**/players/
**/plugins/**/players/**
**/plugins/**/cooldowns/
**/plugins/**/cooldowns/**
**/plugins/**/skins/
**/plugins/**/skins/**
**/plugins/**/lastupdate
**/plugins/**/qs.log
**/plugins/**/temp/
**/plugins/**/cache/
# EssentialsX item id data bundled with the plugin jar, regenerated on load
**/plugins/Essentials/items.json
# Plan auto-downloads the GeoIP database on first run
**/plugins/Plan/GeoLite2-Country.mmdb
# LuckPerms re-downloads its translation bundles on every start (config.yml's
# "auto-install-translations: true"), so this directory is a download cache,
# not configuration -- its own status.json is literally {"lastRefresh": <epoch>}.
# Tracking it meant 35 files per server churned on every single boot (105 across
# the three services), which drowned out every real config change in git status.
**/plugins/**/translations/repository/
# AuthMe writes a timestamped backup of its messages file whenever a plugin
# upgrade adds new keys, e.g. backup_messages_zh_20260731_0922.yml
**/plugins/AuthMe/messages/backup_messages_*.yml
# FancyNpcs records the version it last ran as; regenerated on every start
**/plugins/FancyNpcs/version.yml
# AxoVaults records which storage backend was last active plus a timestamp;
# regenerated on every start, so it is runtime state rather than configuration
**/plugins/AxoVaults/storage-state.yml
**/*.tmp
**/*.db
**/*.mv.db
**/*.trace.db
**/*.bin
**/map-color-cache.dat
**/plugins/**/sessions/
**/plugins/**/schematics/
**/plugins/**/tmp/
**/plugins/**/tmp-client/

# Secrets and keys
**/*.secret
**/forwarding.secret
**/*.pem
**/*.playerskin
# BungeeGuard is decommissioned (migrated to Velocity modern forwarding); never track its config/token
**/BungeeGuard/
**/token.txt

# Unified launcher runtime
pids/
**/*.jar.disabled
