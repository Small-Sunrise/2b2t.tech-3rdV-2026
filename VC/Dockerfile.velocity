FROM eclipse-temurin:25-jre
WORKDIR /runtime
COPY VC/velocity-3.5.0-SNAPSHOT-605.jar /app/velocity.jar
COPY scripts/inject-db-secrets.sh /usr/local/bin/inject-runtime-credentials
COPY minecraft-docker/scripts/velocity-entrypoint.sh /usr/local/bin/velocity-entrypoint
RUN chmod +x /usr/local/bin/inject-runtime-credentials /usr/local/bin/velocity-entrypoint
EXPOSE 50016 19132/udp
ENTRYPOINT ["/usr/local/bin/velocity-entrypoint"]
