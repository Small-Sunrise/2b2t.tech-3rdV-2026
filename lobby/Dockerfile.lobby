FROM eclipse-temurin:25-jre
WORKDIR /data
COPY lobby/paper.jar /app/server.jar
COPY scripts/inject-db-secrets.sh /usr/local/bin/inject-runtime-credentials
COPY minecraft-docker/scripts/backend-entrypoint.sh /usr/local/bin/backend-entrypoint
RUN chmod +x /usr/local/bin/inject-runtime-credentials /usr/local/bin/backend-entrypoint
EXPOSE 50015
ENTRYPOINT ["/usr/local/bin/backend-entrypoint"]
