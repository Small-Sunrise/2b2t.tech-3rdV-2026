# Velocity forwarding secret (plain text)
FORWARDING_SECRET=

# Floodgate key in PEM format. Use \n for newlines.
FLOODGATE_KEY_PEM=

# QueQiao (VC proxy plugin) WebSocket access token; authenticates inbound
# connections to its message bus on websocket_server (0.0.0.0:52000)
QUEQIAO_ACCESS_TOKEN=

# MariaDB root password (for docker-compose)
MARIADB_ROOT_PASSWORD=

# LuckPerms MySQL database
# Use mariadb:3306 for Docker, 127.0.0.1:3306 for local
LUCKPERMS_DB_HOST=127.0.0.1:3306
LUCKPERMS_DB_NAME=luckperms_2b2t
LUCKPERMS_DB_USER=lpsql
LUCKPERMS_DB_PASSWORD=

# TAB MySQL database (disabled by default, enable in TAB config)
TAB_DB_NAME=tab
TAB_DB_USER=user
TAB_DB_PASSWORD=

# AuthMe MySQL database (lobby server)
AUTHME_DB_HOST=127.0.0.1
AUTHME_DB_NAME=authme
AUTHME_DB_USER=authme
AUTHME_DB_PASSWORD=

# Auto-restart delay after a service exits (seconds)
RESTART_DELAY_SECONDS=300

# Graceful shutdown timeout before forced termination (seconds)
STOP_TIMEOUT_SECONDS=120

# Backup output directory (scripts/backup.sh). Empty/unset defaults to
# <repo-root>/backups.
BACKUP_DIR=

# Backup retention in days before old backups are deleted (scripts/backup.sh)
KEEP_DAYS=7

# Optional Docker JVM memory overrides
VELOCITY_JAVA_XMS=512M
VELOCITY_JAVA_XMX=1G
LOBBY_JAVA_XMS=1G
LOBBY_JAVA_XMX=1G
LOBBY_JAVA_SOFT_MAX=700M
SURVIVAL_JAVA_XMS=8G
SURVIVAL_JAVA_XMX=8G
SURVIVAL_JAVA_SOFT_MAX=6G
